! Exercise IF / ELSEIF / ELSE / SELECT / CASE / DEFAULT and DISABLE / ENABLE
Version,9.6;




  Building,
    Bldg,                    !- Name
    200,                !- North Axis {deg}
    City;                    !- Terrain

  Shading:Overhang,
    OverhangA,               !- Name
    Window1,                 !- Window or Door Name
    0.5;                     !- Height above Window or Door {m}

  Shading:Overhang,
    OverhangB,               !- Name
    Window2,                 !- Window or Door Name
    22;                !- Height above Window or Door {m}

  Output:Variable,*,many,hourly;

  Zone,
    Z1,
    3.000000, 4.000000, 0.666667;  !- three expressions on one line
