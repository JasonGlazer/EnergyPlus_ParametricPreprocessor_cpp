! Exercise IF / ELSEIF / ELSE / SELECT / CASE / DEFAULT and DISABLE / ENABLE
Version,9.6;




  Building,
    Bldg,                    !- Name
    =@@000001,                !- North Axis {deg}
    City;                    !- Terrain

  Shading:Overhang,
    OverhangA,               !- Name
    Window1,                 !- Window or Door Name
    0.5;                     !- Height above Window or Door {m}

  Shading:Overhang,
    OverhangB,               !- Name
    Window2,                 !- Window or Door Name
    =@@000002;                !- Height above Window or Door {m}

  Output:Variable,*,=@@000003,hourly;

  Zone,
    Z1,
    =@@000004, =@@000005, =@@000006;  !- three expressions on one line
