! DISABLE with no object name. The Fortran original searches for an uninitialized
! name (it prints whatever is in memory); the C++ version searches for an empty name.
Version,9.6;

  Parametric:SetValueForRun,
    $v,
    1;

  Parametric:Logic,
    Main,
    DISABLE;

  Shading:Site,
    ObjA,
    =$v,
    1;
