Version,9.6;

  Parametric:SetValueForRun,
    $x,
    2,
    -3.5,
    0,
    1.0E+07,
    0.0000001,
    123456.789,
    abc;

  Parametric:Logic,
    Calc,
    PARAMETER $a,
    PARAMETER $b,
    $a = $x * 2 + 1,
    $b = ($x + 1) * ($x - 1) / 4 ^ 2;

  Material,
    M1,
    =$a,
    =$b,
    =ABS($x),
    =SQRT(ABS($x)),
    =INT($x),
    =EXP(1),
    =LOG(10),
    =SIN(1)+COS(1)+TAN(1),
    =ATAN(1),
    =ASIN(0.5),
    =ACOS(0.5),
    =LEN("hello"),
    =MOD(7~3),
    =$x * 0,
    =100000,
    =100000.5,
    =99999.9999999,
    =0.00001,
    =-0.00001,
    =2 ^ 0.5,
    =1 / 3,
    =1E3 + 1.5E-2,
    =10 - 4 - 3,
    =8*-2,
    =- $x,
    =3 - -2,
    =.5 + 1,
    =1.5e2,
    =$x;
