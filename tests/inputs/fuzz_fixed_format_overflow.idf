! Found by fuzz testing: results between -100000 and -99999.9999995 do not fit
! the Fortran F13.6 edit descriptor and are written as 13 asterisks.
Version,9.6;

  Parametric:SetValueForRun,
    $v,
    -100000,
    100000,
    -99999.9999999,
    -99999.999999;

  Material,
    M,
    =$v * 1,
    =0 - 100000,
    =.5 ^1E2 -(100000) - COS(1E2) * ATAN((0)),
    =-99999.9999996 * 1,
    =99999.9999996 * 1,
    =-100000.0001 * 1,
    =100000.0001 * 1;
